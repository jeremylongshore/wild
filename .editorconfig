# EditorConfig — https://editorconfig.org
# Language: ruby

root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{yml,yaml,json}]
indent_size = 2

[*.{rb,erb,gemspec}]
indent_size = 2

[Rakefile]
indent_size = 2
